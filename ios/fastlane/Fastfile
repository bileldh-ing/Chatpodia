default_platform(:ios)

platform :ios do
  desc "Signed build → TestFlight"
  lane :beta do
    setup_ci
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_P8"],
      in_house: false
    )
    match(type: "appstore", api_key: api_key)
    sh("cd ../.. && flutter build ipa --release --no-codesign --build-number=#{ENV['BUILD_NUMBER'] || '1'}")
    update_code_signing_settings(use_automatic_signing: false, path: "Runner.xcodeproj",
                                 profile_name: "match AppStore com.chatpodia.chatpodia", code_sign_identity: "iPhone Distribution")
    build_app(workspace: "Runner.xcworkspace", scheme: "Runner", export_method: "app-store",
              output_directory: "../build/ios/ipa")
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
